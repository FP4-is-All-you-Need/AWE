{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "modular-forms.schema.json",
 "title": "Single modular constructions (schema 2)",
 "description": "Constructions that need not belong to a modular set. Schema-1 solution rows validate unchanged; schema-2 rows add plane moduli, holes, FP6 value sets, denominators and moduli above 2000, and keep the residue table only for small moduli.",
 "type": "object",
 "required": ["schema_version", "data_version", "kind", "solutions"],
 "additionalProperties": false,
 "properties": {
  "schema_version": {"const": 2},
  "data_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "kind": {"const": "modular_forms"},
  "solutions": {"type": "array", "items": {"oneOf": [
   {"$ref": "modular.schema.json#/properties/solutions/items"},
   {"$ref": "#/$defs/solution2"}
  ]}}
 },
 "$defs": {
  "int": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
  "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
  "value_set": {"enum": ["2xE2M1", "E4M3_integer", "8xE2M3", "16xE3M2"],
   "description": "2xE2M1: twice the FP4 E2M1 values; 8xE2M3 and 16xE3M2: the FP6 values scaled to integers (63 values each). A record names the smallest value set it was checked on; 2xE2M1 is contained in 8xE2M3 and in 16xE3M2 (forms-index.json value_set_inclusion), so a 2xE2M1 record also holds on both FP6 sets."},
  "limb_set": {"enum": ["2xE2M1", "E4M3_integer", "8xE2M3", "16xE3M2", "Z_m"],
   "description": "Z_m: a limb that is not stored; only the planes are stored."},
  "ints": {"type": "array", "items": {"$ref": "#/$defs/int"}, "minItems": 1, "maxItems": 16},
  "side_table": {"type": "array", "maxItems": 4096, "items": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ints"}]}},
  "solution2": {
   "type": "object",
   "required": ["schema_version", "kind", "id", "modulus", "weights", "limb_sets", "planes", "plane_sets", "plane_moduli",
                "products", "denominator", "holes", "reconstruction", "accumulation", "verified"],
   "additionalProperties": false,
   "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "modular"},
    "id": {"type": "string", "pattern": "^awem2_[0-9a-f]{64}$"},
    "modulus": {"type": "integer", "minimum": 2, "maximum": 2147483647},
    "weights": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"$ref": "#/$defs/ints"}, "B": {"$ref": "#/$defs/ints"}}},
    "limb_sets": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"type": "array", "items": {"$ref": "#/$defs/limb_set"}, "minItems": 1, "maxItems": 16},
                    "B": {"type": "array", "items": {"$ref": "#/$defs/limb_set"}, "minItems": 1, "maxItems": 16}}},
    "planes": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"type": "array", "items": {"$ref": "#/$defs/ints"}, "minItems": 1, "maxItems": 256},
                    "B": {"type": "array", "items": {"$ref": "#/$defs/ints"}, "minItems": 1, "maxItems": 256}}},
    "plane_sets": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"type": "array", "items": {"$ref": "#/$defs/value_set"}, "minItems": 1, "maxItems": 256},
                    "B": {"type": "array", "items": {"$ref": "#/$defs/value_set"}, "minItems": 1, "maxItems": 256}}},
    "plane_moduli": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "description": "The modulus each stored plane value must match; a divisor of the modulus.",
     "properties": {"A": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "minItems": 1, "maxItems": 256},
                    "B": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "minItems": 1, "maxItems": 256}}},
    "products": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "required": ["a", "b", "numerator"],
     "additionalProperties": false, "properties": {"a": {"$ref": "#/$defs/count"}, "b": {"$ref": "#/$defs/count"}, "numerator": {"$ref": "#/$defs/int"}}}},
    "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "holes": {"type": "object", "required": ["A", "B", "exact", "method"], "additionalProperties": false,
     "description": "Residues without an encoding on each side. exact: true when every encoding was searched; false when the count is an upper bound.",
     "properties": {"A": {"$ref": "#/$defs/count"}, "B": {"$ref": "#/$defs/count"}, "exact": {"type": "boolean"},
                    "method": {"enum": ["search", "literal_table"],
                     "description": "search: a residue is a hole when no limb vector modulo the modulus gives plane values in the value set modulo each plane modulus (every limb vector is covered, so the count is exact). literal_table: limbs and plane values literally in the value set, without folding; folded encodings were not searched, so a nonzero count is an upper bound."}}},
    "hole_set": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"type": "array", "items": {"$ref": "#/$defs/count"}, "maxItems": 64},
                    "B": {"type": "array", "items": {"$ref": "#/$defs/count"}, "maxItems": 64}}},
    "encoding": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "description": "Limbs per residue (null for a hole); stored only for small moduli, rebuilt by verify.modular_forms otherwise.",
     "properties": {"A": {"$ref": "#/$defs/side_table"}, "B": {"$ref": "#/$defs/side_table"}}},
    "plane_values": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
     "properties": {"A": {"$ref": "#/$defs/side_table"}, "B": {"$ref": "#/$defs/side_table"}}},
    "reconstruction": {"type": "object", "required": ["procedure"], "additionalProperties": false,
     "properties": {"procedure": {"enum": ["none", "divide_d1_then_multiply_d2_inverse"],
                     "description": "none: denominator 1, the sum of the products is the product modulo the modulus. divide_d1_then_multiply_d2_inverse: keep the sum modulo d1 * modulus (verified.check_modulus), divide by d1, then multiply by the inverse of d2 modulo the modulus (verified.den_split). With d2 = 1 this is the same as dividing by the whole denominator."},
                    "note": {"type": "string", "description": "Present with a denominator above 1: only this procedure is checked."}}},
    "prior_checker_versions": {"type": "array", "items": {"enum": ["1.1", "1.3", "1.4"]}, "minItems": 1, "uniqueItems": true,
     "description": "Versions of the separate exact checker that verified the construction before verify/modular_forms.py rebuilt this record. Not part of the id and not rebuilt from the construction."},
    "accumulation": {"type": "object", "required": ["model", "product_bounds", "max_k", "max_k_int32"], "additionalProperties": false,
     "properties": {"model": {"const": "separate_products_then_exact_integer_reconstruction"},
                    "product_bounds": {"type": "array", "items": {"$ref": "#/$defs/count"}},
                    "max_k": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
                    "max_k_int32": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]}}},
    "verified": {"type": "object", "required": ["method", "identity", "check_modulus", "den_split", "fold_rule", "encoding", "n_pairs", "n_residues",
                                                "verifier_version", "date"],
     "additionalProperties": false,
     "properties": {"method": {"enum": ["full_pairs", "module_generators"]},
                    "identity": {"enum": ["modulo_p", "modulo_dm"]},
                    "check_modulus": {"type": "integer", "minimum": 2, "maximum": 9007199254740991,
                     "description": "The modulus of every check, d1 * modulus. Decode: (sum of the products mod check_modulus) / d1, times d2^-1 mod modulus."},
                    "den_split": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2,
                     "description": "[d1, d2] with denominator = d1 * d2, every prime of d1 dividing the modulus and d2 coprime to it."},
                    "fold_rule": {"type": "boolean", "description": "Whether the fold rule holds; when false the given table was checked on every pair."},
                    "plane_values_binding": {"const": true,
                     "description": "Present when fold_rule is false: the stored plane values must be used exactly as stored, not reduced modulo the plane moduli. When fold_rule is true, reducing a plane value modulo its plane modulus keeps the identity modulo verified.check_modulus."},
                    "encoding": {"enum": ["all_residues", "served_residues"]},
                    "n_pairs": {"$ref": "#/$defs/count"},
                    "n_residues": {"type": "object", "required": ["A", "B"], "additionalProperties": false,
                     "properties": {"A": {"$ref": "#/$defs/count"}, "B": {"$ref": "#/$defs/count"}}},
                    "verifier_version": {"const": "2.0.0"},
                    "date": {"type": "string", "format": "date"}}}
   }
  }
 }
}
